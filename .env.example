# ATS Screener environment variables (PRD §16).
# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ─── LLM providers ────────────────────────────────────────────────────────────
# At least one must be configured. With none, the app still works: scoring falls
# back to the deterministic engine, which runs client-side (ADR 0001 §2, §9).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local provider. Tried first when set, so data stays on the machine.
# The 240s default is only reachable on self-hosted adapter-node; on Vercel it is
# clamped by LLM_BUDGET_MS below (ADR 0001 §8).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=240000

# Total server-side budget for the whole provider chain, in ms. Must stay under the
# platform's function timeout (Vercel maxDuration is 60s), and the client timeout
# must stay under this.
LLM_BUDGET_MS=55000

# ─── Firebase (deferred — anonymous mode is the current build target) ─────────
# Setting PUBLIC_FIREBASE_PROJECT_ID switches auth to Firebase mode. Leave unset
# for anonymous mode with localStorage history.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ─── Operations ───────────────────────────────────────────────────────────────
# Bearer token for /api/admin/rate-limit-stats. When unset the route 404s.
ADMIN_TOKEN=

PUBLIC_SCAN_LOG_SAMPLE_RATE=1.0
PUBLIC_ERROR_SAMPLE_RATE=0.05
PUBLIC_VITALS_SAMPLE_RATE=0.05

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
